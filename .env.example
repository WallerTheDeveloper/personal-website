# Umami analytics. Copy to `.env` and fill both, or leave them out entirely —
# `src/analytics.ts` is a no-op unless BOTH are set.
#
# Neither is a secret: they are baked into the client bundle at build time and
# are visible in the page source, exactly like the <script> tag Umami's own
# install instructions give you. Do not put anything private in a VITE_ var.

# The URL of the Umami tracker script, e.g. https://cloud.umami.is/script.js
VITE_UMAMI_SRC=

# The website id from the Umami dashboard (a UUID).
VITE_UMAMI_ID=
